{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GeoCarto",
  "version": "0.2.1",
  "identifier": "com.kilianvivien.geocarto",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GeoCarto",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 600,
        "visible": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Graphics and Design",
    "shortDescription": "Visual-first cartography editor",
    "longDescription": "GeoCarto is an open-canvas map editor for editorial and casual map makers — open a basemap, annotate it, and export print-ready images.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
